{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PLC & SCADA Simulator",
  "version": "0.1.2",
  "identifier": "in.edu.vsa.plcsimulator",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../web-build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "PLC & SCADA Simulator",
        "width": 1360,
        "height": 840,
        "minWidth": 1024,
        "minHeight": 640,
        "center": true,
        "visible": true,
        "backgroundColor": "#e9edf2",
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection,Translate,msEdgeTranslate,AutofillServerCommunication --disable-background-networking --disable-component-update --no-pings"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost; font-src 'self'; object-src 'none'; base-uri 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Vidyasagar Academy",
    "copyright": "Copyright (C) 2026 Vidyasagar Academy. Licensed under GPL-3.0.",
    "category": "Education",
    "shortDescription": "PLC programming simulator for students, teachers and hobbyists",
    "longDescription": "PLC & SCADA Simulator lets students, teachers and hobbyists draw PLC programs as function block diagrams, wire field devices to a PLC training panel, build SCADA operator screens, and simulate it all in real time. Fully offline. Developed by Prof. Dattaraj S. Vidyasagar & Prof. Yash D. Vidyasagar for Vidyasagar Academy.",
    "homepage": "https://vsa.edu.in/software/",
    "license": "GPL-3.0-only",
    "licenseFile": "../LICENSE",
    "fileAssociations": [
      {
        "ext": ["vsaplc"],
        "name": "PLC & SCADA Simulator project",
        "description": "PLC & SCADA Simulator project",
        "role": "Editor"
      }
    ],
    "resources": {
      "../LICENSE": "LICENSE",
      "../NOTICE": "NOTICE",
      "../THIRD-PARTY-NOTICES.txt": "THIRD-PARTY-NOTICES.txt",
      "../privacy-policy.md": "privacy-policy.md"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "perMachine",
        "displayLanguageSelector": false
      }
    }
  }
}
