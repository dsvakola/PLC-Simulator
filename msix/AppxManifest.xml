<?xml version="1.0" encoding="utf-8"?>
<!-- MSIX package for the Microsoft Store. msix.bat fills in the version
     (@VERSION@) from src-tauri\tauri.conf.json, with ".0" added.
     Before the first Store upload, reserve the name "PLC Simulator" in
     Partner Center and copy the Package/Identity/Name, Publisher and
     PublisherDisplayName it shows into the three places marked below. -->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap">

  <!-- Name and Publisher: from Partner Center. -->
  <Identity
    Name="VidyasagarAcademy.PLCSimulator"
    Publisher="CN=E5EAB892-17BA-4AC0-A205-3AE9F2BA13DD"
    Version="@VERSION@"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>PLC Simulator</DisplayName>
    <!-- PublisherDisplayName: from Partner Center. -->
    <PublisherDisplayName>Vidyasagar Academy</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <Description>PLC Simulator lets students, teachers and hobbyists write PLC programs in ladder logic, run them on a simulated CPU and watch the inputs, outputs and power flow live. Fully offline. Developed by Prof. Dattaraj S. Vidyasagar and Prof. Yash D. Vidyasagar for Vidyasagar Robotics Academy.</Description>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="PLCSimulator" Executable="plc-simulator.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="PLC Simulator"
        Description="PLC programming simulator for students, teachers and hobbyists"
        BackgroundColor="#1B3A5C"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile
          ShortName="PLC Simulator"
          Wide310x150Logo="Assets\Wide310x150Logo.png"
          Square71x71Logo="Assets\Square71x71Logo.png"
          Square310x310Logo="Assets\Square310x310Logo.png">
          <uap:ShowNameOnTiles>
            <uap:ShowOn Tile="square150x150Logo" />
            <uap:ShowOn Tile="wide310x150Logo" />
            <uap:ShowOn Tile="square310x310Logo" />
          </uap:ShowNameOnTiles>
        </uap:DefaultTile>
      </uap:VisualElements>
      <Extensions>
        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="vsaplc">
            <uap:DisplayName>PLC Simulator project</uap:DisplayName>
            <uap:Logo>Assets\Square44x44Logo.png</uap:Logo>
            <uap:SupportedFileTypes>
              <uap:FileType>.vsaplc</uap:FileType>
            </uap:SupportedFileTypes>
          </uap:FileTypeAssociation>
        </uap:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
